# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq (LLM provider -- required, config.py has no default for this)
GROQ_API_KEY=your-groq-key-here

# Google Gemini (legacy/unused -- gemini_api_key has a default in
# config.py and isn't referenced anywhere else in the codebase; kept
# here only in case it's reintroduced later, not required to run)
GEMINI_API_KEY=your-gemini-key-here

# App
APP_ENV=development
LOG_LEVEL=INFO
